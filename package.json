{
  "name": "@aegis-gateway/server",
  "version": "0.1.0",
  "private": false,
  "license": "Apache-2.0",
  "type": "module",
  "engines": { "node": ">=22.0.0", "npm": ">=10.0.0" },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "npm run build:policy && tsc -p tsconfig.json",
    "build:policy": "bash scripts/build-policy.sh",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:opa": "opa test policy/bundle -v",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@fastify/rate-limit": "10.3.0",
    "@open-policy-agent/opa-wasm": "^1.9.0",
    "bcrypt": "6.0.0",
    "drizzle-orm": "0.45.2",
    "fastify": "5.8.5",
    "fastify-plugin": "5.0.1",
    "fastify-type-provider-zod": "6.1.0",
    "jose": "^5.9.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/node": "22.10.2",
    "drizzle-kit": "0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "4.19.2",
    "typescript": "5.7.2",
    "vitest": "^2.1.8"
  }
}
