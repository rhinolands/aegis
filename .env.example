NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://aegis:CHANGE_ME@localhost:5432/aegis
# Comma-separated JWKS URLs the gateway trusts for caller JWTs (optional in v0.1)
JWT_JWKS_URLS=
# Master key (base64, 32 bytes) for per-subject audit payload encryption (crypto-shred)
AUDIT_MASTER_KEY=REPLACE_WITH_BASE64_32_BYTES
# S3-compatible export target
EXPORT_S3_ENDPOINT=http://localhost:9000
EXPORT_S3_BUCKET=aegis-audit
EXPORT_S3_ACCESS_KEY=CHANGE_ME
EXPORT_S3_SECRET_KEY=CHANGE_ME
EXPORT_S3_REGION=us-east-1
